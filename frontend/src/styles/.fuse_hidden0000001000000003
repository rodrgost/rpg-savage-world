/* ─── Shared Page Layout ───────────────────────────── */

.page-home,
.page-worlds,
.page-character,
.page-world-create,
.page-rules,
.page-char-form {
  display: grid;
  gap: var(--space-4);
}

.panel > h2:first-child,
.page-char-form .page-title,
.page-rules-title {
  margin: 0;
  font-size: clamp(1.75rem, 2.2vw, 2.6rem);
  line-height: 1.1;
  letter-spacing: -0.03em;
}

.panel > p.muted:first-of-type,
.page-rules-subtitle {
  max-width: 70ch;
}

.readonly-note {
  margin: 0;
}

/* ─── Home ─────────────────────────────────────────── */

.page-home {
  display: grid;
  gap: var(--space-4);
}

/* Stat steps no sidebar do hero */
.home-stat-step {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--font-sm);
}

.home-stat-step-num {
  min-width: 22px;
  font-size: var(--font-xs);
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}

.home-stat-step-icon {
  font-size: 1rem;
  line-height: 1;
}

/* Ícone grande no topo da home-card */
.home-card-icon {
  font-size: 2rem;
  line-height: 1;
  display: block;
}

.home-card-action {
  color: var(--text-primary);
  font-size: var(--font-sm);
  font-weight: 600;
}

/* Flow step renovado */
.home-flow-step-header {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.home-flow-num {
  font-size: clamp(1.5rem, 3vw, 2rem);
  color: var(--text-muted);
  font-weight: 700;
  line-height: 1;
}

.home-flow-connector {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, var(--border-default) 0%, transparent 100%);
}

.home-flow-step strong {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--text-primary);
}

.home-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.9fr);
  gap: clamp(18px, 3vw, 36px);
  align-items: stretch;
  background: var(--glass-bg);
}

.home-hero-copy {
  display: grid;
  gap: var(--space-4);
}

.home-eyebrow {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 6px 12px;
  border-radius: var(--radius-full);
  background: var(--bg-chip);
  border: 1px solid var(--border-default);
  color: var(--text-secondary);
  font-size: var(--font-xs);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 700;
}

.home-hero h2 {
  margin: 0;
  max-width: 16ch;
  font-size: clamp(2.2rem, 5vw, 4rem);
  line-height: 0.98;
  letter-spacing: -0.04em;
  text-transform: uppercase;
}

.home-hero p,
.home-card p,
.home-flow-step p,
.auth-panel p,
.auth-highlights p,
.auth-note p,
.auth-footer p {
  margin: 0;
  color: var(--text-secondary);
}

.home-hero-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.home-primary-link,
.home-secondary-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 18px;
  border-radius: var(--radius-full);
  border: 1px solid var(--border-default);
  font-size: var(--font-sm);
  font-weight: 600;
}

.home-primary-link {
  background: var(--gradient-accent);
  color: #fff;
  border-color: transparent;
  box-shadow: var(--shadow-glow);
}

.home-primary-link:hover {
  color: #fff;
  transform: translateY(-1px);
}

.home-secondary-link {
  background: rgba(255, 255, 255, 0.02);
  color: var(--text-primary);
}

.home-secondary-link:hover {
  color: var(--text-primary);
  border-color: var(--accent);
  background: var(--bg-elevated);
}

.home-hero-side {
  display: grid;
  gap: var(--space-3);
}

.home-stat-card {
  display: grid;
  gap: var(--space-2);
  padding: var(--space-4);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  border: 1px solid var(--border-default);
}

.home-stat-card--accent {
  background: var(--bg-elevated);
  border-color: var(--border-strong);
}

.home-stat-label {
  font-size: var(--font-xs);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
}

.home-card-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-3);
}

.home-card-link {
  color: inherit;
}

.home-card-link:hover {
  color: inherit;
}

.home-card {
  height: 100%;
  display: grid;
  gap: var(--space-3);
  padding: var(--space-4);
  border-radius: var(--radius-lg);
  border: 1px solid rgba(255, 255, 255, 0.05);
  background: linear-gradient(180deg, rgba(20, 26, 37, 0.94) 0%, rgba(13, 17, 25, 0.98) 100%);
  box-shadow: 0 18px 30px rgba(0, 0, 0, 0.18);
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}

.home-card h3,
.home-flow-panel h3,
.auth-panel h1,
.auth-panel h2 {
  margin: 0;
}

.home-card span {
  color: var(--text-primary);
  font-size: var(--font-sm);
  font-weight: 600;
}

.home-card-link:hover .home-card {
  transform: translateY(-3px);
  border-color: var(--border-strong);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
}

.home-flow-panel {
  display: grid;
  gap: var(--space-4);
}

.home-flow-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-3);
}

.home-flow-step {
  position: relative;
  display: grid;
  gap: var(--space-2);
  padding: var(--space-5) var(--space-4) var(--space-4);
  border-radius: var(--radius-lg);
  background: rgba(10, 14, 22, 0.68);
  border: 1px solid var(--border-default);
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}

.home-flow-step:hover {
  transform: translateY(-3px);
  border-color: var(--border-strong);
  box-shadow: var(--shadow-md);
}

.home-flow-icon {
  position: absolute;
  top: var(--space-4);
  right: var(--space-4);
  font-size: 1.4rem;
  line-height: 1;
  opacity: 0.8;
}

.home-flow-step strong {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 700;
}

/* ─── Auth ────────────────────────────────────────── */

/* Google icon no botão */
.auth-google-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

.auth-google-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.auth-screen {
  min-height: 100vh;
  padding: clamp(20px, 4vw, 40px);
  display: grid;
  place-items: center;
}

.auth-screen--loading {
  background: var(--bg-app);
}

.auth-stage {
  width: min(100%, 1160px);
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.95fr);
  gap: clamp(18px, 3vw, 28px);
}

.auth-panel,
.auth-loading-card {
  position: relative;
  overflow: hidden;
  border-radius: 28px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 32px 70px rgba(0, 0, 0, 0.30);
}

.auth-panel::before,
.auth-loading-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 42%);
  pointer-events: none;
}

.auth-panel--hero {
  display: grid;
  gap: var(--space-5);
  padding: clamp(28px, 4vw, 44px);
  background: var(--bg-surface);
}

.auth-panel--hero h1 {
  max-width: 11ch;
  font-size: clamp(2.6rem, 5vw, 4.4rem);
  line-height: 0.95;
  letter-spacing: -0.04em;
  background: linear-gradient(135deg, #fff 0%, var(--text-muted) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.auth-panel--form,
.auth-loading-card {
  display: grid;
  gap: var(--space-4);
  padding: clamp(24px, 3vw, 34px);
  background: var(--bg-card);
}

.auth-loading-card {
  width: min(100%, 620px);
}

.auth-kicker {
  display: inline-flex;
  width: fit-content;
  padding: 6px 12px;
  border-radius: var(--radius-full);
  background: var(--bg-chip);
  border: 1px solid var(--border-default);
  color: var(--text-secondary);
  font-size: var(--font-xs);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 700;
}

@keyframes authKickerPulse {
  0%, 100% { box-shadow: 0 0 0px var(--accent-glow); }
  50% { box-shadow: 0 0 10px var(--accent-glow); }
}

.auth-highlights {
  display: grid;
  gap: var(--space-3);
}

.auth-highlights > div,
.auth-note {
  display: grid;
  gap: var(--space-2);
  padding: var(--space-4);
  border-radius: var(--radius-lg);
  background: rgba(8, 12, 19, 0.56);
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.auth-note--warn {
  border-color: rgba(255, 212, 59, 0.32);
  background: rgba(70, 55, 10, 0.18);
}

.auth-note-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.auth-mode-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  padding: 6px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.auth-mode-switch button {
  background: transparent;
  color: var(--text-secondary);
  border-radius: var(--radius-full);
}

.auth-mode-switch button.active {
  background: var(--bg-elevated);
  color: var(--text-primary);
}

.auth-copy {
  display: grid;
  gap: var(--space-2);
}

.auth-form {
  display: grid;
  gap: var(--space-3);
}

.auth-divider {
  position: relative;
  text-align: center;
}

.auth-divider::before {
  content: '';
  position: absolute;
  inset: 50% 0 auto;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.auth-divider span {
  position: relative;
  padding: 0 12px;
  background: rgba(14, 18, 27, 0.98);
  color: var(--text-muted);
  font-size: var(--font-xs);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.auth-google-button {
  min-height: 46px;
}

.auth-footer {
  display: grid;
  gap: var(--space-2);
}

.auth-inline-button {
  padding: 0;
  background: transparent;
  border: 0;
  color: #b5c8ff;
  font-weight: 600;
}

.auth-inline-button:hover:enabled {
  background: transparent;
  color: #d7e2ff;
  box-shadow: none;
}

.auth-error {
  margin-top: 0;
}

/* ─── Botão de IA (Gerar Lore / Gerar Imagem) ──────── */

.btn-ai-gen {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 18px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-strong);
  background: var(--bg-elevated);
  color: var(--text-secondary);
  font-size: var(--font-sm);
  font-weight: 600;
  cursor: pointer;
  transition: all 180ms ease;
  width: 100%;
}

.btn-ai-gen:hover:not(:disabled) {
  border-color: var(--border-accent);
  background: var(--bg-chip);
  color: var(--text-primary);
}

.btn-ai-gen:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.btn-ai-spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.15);
  border-top-color: var(--text-secondary);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  flex-shrink: 0;
}

/* ─── Character Form (Create / Edit) ───────────────── */

.page-char-form {
  padding-bottom: var(--space-8);
  align-content: start;
}

.page-char-form form {
  display: grid;
  gap: var(--space-4);
}

.page-char-form .section-card {
  margin-bottom: 0;
}

.page-char-form .page-title {
  font-weight: 700;
}

.page-char-form .hero-image {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-card);
  border: 1px solid var(--border-default);
  margin-bottom: var(--space-4);
}

.page-char-form .hero-image img {
  display: block;
  width: 100%;
  max-width: 320px;
  margin: 0 auto;
  aspect-ratio: 3 / 4;
  object-fit: cover;
}

.page-char-form .hero-image-actions {
  padding: var(--space-3);
  display: flex;
  justify-content: center;
}

/* ─── Attribute Row ────────────────────────────────── */

.attr-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.attr-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3);
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-subtle);
}

.attr-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  background: var(--accent-soft);
  flex-shrink: 0;
}

.attr-info {
  flex: 1;
  min-width: 0;
}

.attr-info strong {
  display: block;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}

.attr-info small {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: 1.3;
  margin-top: 2px;
}

.attr-row .die-selector {
  flex-shrink: 0;
}

/* ─── Skill Grid ───────────────────────────────────── */

.skill-group {
  margin-bottom: var(--space-4);
}

.skill-group-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: 0 0 var(--space-2);
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--border-subtle);
}

.skill-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-2);
}

.skill-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  padding: 8px var(--space-3);
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  transition: all 150ms ease;
  cursor: pointer;
}

.skill-row:hover {
  background: var(--bg-card);
}

.skill-row.active {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.skill-check {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  cursor: pointer;
  flex-direction: row;
}

.skill-check input[type='checkbox'] {
  accent-color: var(--accent);
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.skill-row.active .skill-check {
  color: var(--text-primary);
  font-weight: 500;
}

.skill-row .die-selector {
  flex-shrink: 0;
}

/* ─── Edge / Hindrance Chips ───────────────────────── */

.chips-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.chip-group-title {
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: var(--space-3) 0 var(--space-2);
  width: 100%;
}

.chip-group-title:first-child {
  margin-top: 0;
}

.chip--major.active {
  border-color: var(--feedback-error);
  background: rgba(255, 107, 107, 0.10);
  color: var(--feedback-error);
}

.chip--minor.active {
  border-color: var(--feedback-warn);
  background: rgba(255, 212, 59, 0.10);
  color: var(--feedback-warn);
}

/* ─── Derived Stats Bar ────────────────────────────── */

.derived-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: var(--space-2);
}

.derived-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-3);
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-subtle);
  text-align: center;
}

.derived-stat-value {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
}

.derived-stat-label {
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin-top: 4px;
}

/* ─── Action Buttons Footer ────────────────────────── */

.form-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-5);
}

.form-actions button {
  width: 100%;
  padding: 12px 16px;
  font-size: var(--font-base);
}

.form-actions .button-primary-lg {
  background: var(--gradient-accent);
  border: none;
  font-size: var(--font-md);
  font-weight: 700;
  padding: 14px 20px;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-glow);
}

.form-actions .button-primary-lg:hover:enabled {
  opacity: 0.9;
  box-shadow: var(--shadow-glow), var(--shadow-md);
}

/* ─── Page List Shared (Worlds / Campaigns / Characters) ── */

.page-list-header {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.page-list-icon {
  font-size: 2rem;
  line-height: 1;
  flex-shrink: 0;
  margin-top: 2px;
}

.page-list-header h2 {
  margin: 0;
  font-size: clamp(1.6rem, 2.6vw, 2.4rem);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.page-list-header > div {
  flex: 1;
  min-width: 0;
}

.page-list-subtitle {
  margin: 4px 0 0 !important;
  font-size: var(--font-sm) !important;
}

.page-list-cta {
  align-self: flex-start;
  white-space: nowrap;
  padding: 10px 18px;
  font-size: var(--font-sm);
  font-weight: 700;
  background: var(--text-primary);
  color: var(--bg-app);
  border-radius: var(--radius-full);
  box-shadow: none;
}

.page-list-cta:hover:enabled {
  filter: brightness(0.92);
}

.page-list-toolbar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.list-filter-select {
  flex: 1 1 200px;
  max-width: 360px;
}

/* ── Worlds toolbar: filter tabs + search ── */
.world-list-toolbar {
  justify-content: space-between;
}

.world-filter-tabs {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 2px;
  padding: 4px;
  border-radius: var(--radius-full);
  background: var(--bg-card);
  border: 1px solid var(--border-default);
}

.world-filter-tab {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-secondary);
  font-size: var(--font-xs);
  font-weight: 600;
  padding: 7px 14px;
  border-radius: var(--radius-full);
  white-space: nowrap;
}

.world-filter-tab:hover:enabled {
  filter: none;
  color: var(--text-primary);
}

.world-filter-tab.is-active {
  background: var(--bg-elevated);
  color: var(--text-primary);
}

.world-toolbar-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.world-search {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 9px 14px;
  border-radius: var(--radius-full);
  background: var(--bg-field);
  border: 1px solid var(--border-default);
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.world-search input {
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-primary);
  font: inherit;
  width: 160px;
}

.world-search input::placeholder {
  color: var(--text-muted);
}

.world-search:focus-within {
  border-color: var(--border-accent);
}

/* ── Link inline (substituindo <a> com style cursor) ── */
.link-btn {
  background: none;
  border: none;
  padding: 0;
  color: var(--accent);
  font-size: inherit;
  font-weight: 600;
  cursor: pointer;
  text-decoration: underline;
}

.link-btn:hover {
  color: #8fa8ff;
  background: none;
  box-shadow: none;
}

/* ── Empty state ── */
.list-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  padding: clamp(32px, 6vw, 64px) var(--space-4);
  text-align: center;
  border: 1px dashed rgba(255,255,255,0.08);
  border-radius: var(--radius-lg);
  background: rgba(255,255,255,0.01);
  animation: fadeInUp 300ms ease;
}

.list-empty-icon {
  font-size: 3rem;
  line-height: 1;
  opacity: 0.6;
}

.list-empty-title {
  margin: 0;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
}

.list-empty-sub {
  margin: 0;
  max-width: 44ch;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.list-empty-state button:not(.link-btn) {
  margin-top: var(--space-2);
  padding: 10px 20px;
  font-size: var(--font-sm);
  font-weight: 600;
}

/* ── Skeleton loader ── */
.list-skeleton {
  display: grid;
  gap: var(--space-5);
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
}

.skeleton-card {
  height: 180px;
  border-radius: var(--radius-md);
  background: linear-gradient(90deg,
    rgba(255,255,255,0.04) 0%,
    rgba(255,255,255,0.08) 50%,
    rgba(255,255,255,0.04) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.4s ease infinite;
}

.skeleton-card--tall {
  height: 340px;
}

@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ─── Page: Character List ─────────────────────────── */

.page-character .character-card-grid {
  display: grid;
  gap: var(--space-5);
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  margin-bottom: var(--space-4);
}

.page-character .character-card {
  border: 1px solid var(--border-default);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 18px 32px rgba(0, 0, 0, 0.16);
  transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
}

.page-character .character-card.character-card-clickable {
  cursor: pointer;
}

.page-character .character-card.character-card-clickable:hover {
  border-color: var(--accent);
  box-shadow: 0 20px 36px rgba(0, 0, 0, 0.22), 0 0 12px var(--accent-glow);
  transform: translateY(-2px);
}

/* ── Topo: contexto (universo → campanha → nome) ── */
.page-character .character-card-context {
  padding: var(--space-3) var(--space-4) var(--space-2);
  border-bottom: 1px solid var(--border-default);
}

.page-character .char-breadcrumb {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin: 0 0 4px;
}

.page-character .char-breadcrumb-sep {
  opacity: 0.5;
}

.page-character .char-name {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-primary);
}

/* ── Imagem ── */
.card-image {
  width: 100%;
  display: block;
  object-fit: cover;
  border-bottom: 1px solid var(--border-default);
}

.card-image--world {
  aspect-ratio: 16 / 9;
}

.card-image--character {
  aspect-ratio: 3 / 4;
  object-position: top center;
  max-height: 280px;
}

/* ── Body ── */
.page-character .character-card-body {
  padding: var(--space-3) var(--space-4);
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.page-character .entity-card-meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.page-character .char-subtitle {
  margin: 0;
  font-size: var(--font-sm);
}

/* ── Seções de dados ── */
.page-character .character-sheet-summary {
  border-top: 1px solid var(--border-default);
  padding-top: var(--space-2);
  display: grid;
  gap: 6px;
}

.page-character .character-sheet-summary > .muted {
  margin: 0;
  font-size: var(--font-xs);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

/* ── Grid de atributos ── */
.page-character .char-attributes-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 4px;
}

.page-character .char-attr-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--bg-muted);
  border-radius: var(--radius-xs);
  padding: 4px 2px;
  gap: 2px;
}

.page-character .char-attr-label {
  font-size: var(--font-xs);
  color: var(--text-muted);
  font-weight: 500;
}

.page-character .char-attr-value {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--accent);
}

/* ── Chips (perícias, vantagens, complicações) ── */
.page-character .char-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.page-character .chip {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: var(--radius-xs);
  font-size: var(--font-xs);
  font-weight: 500;
  line-height: 1.6;
  white-space: nowrap;
}

.page-character .chip--skill {
  background: var(--accent-soft);
  color: var(--text-primary);
}

.page-character .chip--edge {
  background: rgba(52, 211, 153, 0.12);
  color: #6ee7b7;
}

.page-character .chip--major {
  background: rgba(251, 146, 60, 0.15);
  color: #fb923c;
}

.page-character .chip--minor {
  background: rgba(250, 204, 21, 0.12);
  color: #fbbf24;
}

/* ── Actions / Footer ── */
.page-character .character-card-actions {
  padding: var(--space-3) var(--space-4);
  border-top: 1px solid var(--border-default);
}

.page-character .character-card-actions button {
  width: 100%;
}

.page-character .character-card-actions .btn-play {
  background: var(--bg-elevated);
  color: var(--text-primary);
  font-weight: 700;
  border: 1px solid var(--border-strong);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-sm);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  letter-spacing: 0.02em;
  transition: all 200ms ease;
}

.page-character .character-card-actions .btn-play:hover:not(:disabled) {
  border-color: var(--border-accent);
  background: var(--bg-chip);
  filter: brightness(1.08);
}

.page-character .character-card-actions .btn-play:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  animation: none;
}

.btn-play-spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255,255,255,0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.65s linear infinite;
  flex-shrink: 0;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ─── Page: Worlds ─────────────────────────────────── */

.page-world-create textarea,
.page-character textarea {
  min-height: 100px;
}

/* ── Lore Section ── */

.lore-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.lore-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.lore-section-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
}

.lore-tabs {
  display: flex;
  gap: 4px;
  background: var(--bg-muted);
  border-radius: var(--radius-sm);
  padding: 2px;
}

.lore-tab {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 12px;
  padding: 4px 12px;
  border-radius: var(--radius-sm);
  color: var(--text-muted);
  transition: background 0.15s ease, color 0.15s ease;
}

.lore-tab:hover {
  color: var(--text-primary);
}

.lore-tab.active {
  background: var(--bg-card);
  color: var(--text-primary);
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
}

.lore-textarea {
  min-height: 400px !important;
  font-size: 15px;
  line-height: 1.7;
  font-family: inherit;
}

.lore-preview {
  min-height: 400px;
  max-height: 70vh;
  overflow-y: auto;
  font-size: 16px;
  line-height: 1.8;
  padding: var(--space-4) var(--space-5);
}

.lore-preview h1,
.lore-preview h2,
.lore-preview h3 {
  color: var(--accent);
  margin-top: 1.2em;
}

.lore-preview h1 { font-size: 1.6em; }
.lore-preview h2 { font-size: 1.35em; }
.lore-preview h3 { font-size: 1.15em; }

.lore-preview p {
  margin-bottom: 0.9em;
}

.lore-preview ul,
.lore-preview ol {
  margin-bottom: 0.9em;
  padding-left: 24px;
}

.lore-preview li {
  margin-bottom: 0.3em;
}

.lore-preview blockquote {
  border-left: 3px solid var(--accent);
  margin: 0.8em 0;
  padding: 0.4em 1em;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.03);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

.lore-preview strong {
  color: var(--text-primary);
}

.lore-preview hr {
  border: none;
  border-top: 1px solid var(--border-subtle);
  margin: 1.5em 0;
}

.image-preview {
  border: 1px solid var(--border-default);
  border-radius: var(--radius-sm);
  background: var(--bg-field);
  padding: var(--space-2);
}

/* ── LLM Actions Top ── */

.llm-actions-top {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}

/* ── Story Characters ── */

.story-characters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: var(--space-3);
}

.story-character-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: var(--space-3);
}

.story-character-header {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.story-character-name {
  font-size: var(--font-sm);
  color: var(--text-primary);
}

.story-character-role {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--accent);
  opacity: 0.85;
}

.story-character-description {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.5;
  margin: 0;
}

.story-character-status {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 2px 8px;
  align-self: flex-start;
  margin-top: var(--space-1);
}

.image-preview-img {
  display: block;
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-default);
  background: var(--bg-muted);
  object-fit: cover;
}

.image-preview-img--world {
  aspect-ratio: 16 / 9;
}

.image-preview-img--character {
  aspect-ratio: 1 / 1;
}

.page-worlds .markdown-view {
  min-height: 180px;
}

.page-worlds .world-card-grid {
  display: grid;
  gap: var(--space-5);
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
}

.page-worlds .world-card {
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  overflow: hidden;
  box-shadow: 0 18px 32px rgba(0, 0, 0, 0.16);
  transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
}

.page-worlds .world-card.world-card-clickable {
  cursor: pointer;
}

.page-worlds .world-card.world-card-clickable:hover {
  border-color: var(--accent);
  box-shadow: 0 20px 36px rgba(0, 0, 0, 0.22), 0 0 12px var(--accent-glow);
  transform: translateY(-2px);
}

.page-worlds .world-card.is-selected {
  border-color: var(--accent);
  box-shadow: inset 0 0 0 1px var(--accent);
}

.page-worlds .world-actions-panel {
  margin-top: var(--space-4);
}

/* Overlay de badge/título/ação sobre a imagem (substitui header/footer separados) */
.page-worlds .card-image-frame {
  aspect-ratio: 16 / 9;
}

.page-worlds .card-image--placeholder {
  height: 100%;
  background: var(--gradient-hero);
}

.world-card-top {
  position: absolute;
  inset: 0 0 auto 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3);
  z-index: 1;
}

.world-card-bottom {
  position: absolute;
  inset: auto 0 0 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-2);
  padding: var(--space-4);
  z-index: 1;
}

.world-card-bottom h3 {
  margin: 0;
  font-size: var(--font-lg);
  color: var(--text-primary);
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
}

.world-card-link-action {
  flex-shrink: 0;
  background: rgba(10, 12, 16, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--text-primary);
  font-size: var(--font-xs);
  font-weight: 600;
  padding: 7px 12px;
  border-radius: var(--radius-full);
  white-space: nowrap;
  opacity: 0;
  transform: translateY(4px);
  transition: opacity 150ms ease, transform 150ms ease, background 150ms ease;
}

.world-card:hover .world-card-link-action,
.world-card:focus-within .world-card-link-action {
  opacity: 1;
  transform: translateY(0);
}

.world-card-link-action:hover:enabled {
  filter: none;
  background: var(--accent);
  border-color: var(--accent);
}

/* ─── Page: Game ───────────────────────────────────── */

.game-back-btn {
  flex-shrink: 0;
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: 5px;
  padding: 0.25rem 0.6rem;
  font-size: 0.75rem;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s;
  line-height: 1.4;
  white-space: nowrap;
}

.game-back-btn:hover {
  color: var(--text-primary);
  border-color: var(--border-default);
}

.page-game {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  width: 100%;
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
  padding: 0 var(--content-gutter);
  flex: 1;
  min-height: 0;
  overflow: visible;
}

.page-game .game-hud {
  flex-shrink: 0;
  flex-wrap: nowrap;
  overflow: hidden;
}

/* Round E: linha única — título encolhe com reticências em vez de quebrar em 3 linhas */
.page-game .game-hud-title {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1 1 auto;
  min-width: 0;
}

.page-game .subheader-status {
  flex-wrap: nowrap;
  flex-shrink: 0;
  overflow: hidden;
}

.page-game .hud-expand-toggle {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: var(--radius-full);
  border: 1px solid var(--border-subtle);
  background: transparent;
  color: var(--text-secondary);
  cursor: pointer;
  font-size: 0.7rem;
  line-height: 1;
  transition: all 150ms ease;
}

.page-game .hud-expand-toggle:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
}

.page-game .hud-actions-row {
  flex-basis: 100%;
  width: 100%;
  margin-top: var(--space-1);
  padding-top: var(--space-1);
  border-top: 1px solid var(--border-subtle);
}

/* ações exibidas dentro do próprio header, quebrando para uma 2ª linha interna */
.page-game .game-hud.hud-expanded {
  flex-wrap: wrap;
  overflow: visible;
}

.page-game .chat-log {
  flex: 1;
  min-height: 0;
  max-height: none;
  /* respiro extra para o brilho/sombra dos cards não ser cortado pelo próprio scroll (overflow-y: auto força overflow-x a "auto") */
  padding: 0 14px 4px;
  margin: 0 -14px;
}

.page-game .msg pre {
  margin-top: var(--space-1);
}

.page-game .form-grid {
  margin-top: 0;
  border-top: 1px solid var(--glass-border);
  padding-top: var(--space-1);
  padding-bottom: calc(var(--space-1) + env(safe-area-inset-bottom, 0px));
  position: sticky;
  bottom: 0;
  z-index: 10;
  background: var(--glass-bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.page-game .form-grid .field-label {
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--text-secondary);
}

.page-game .input-row {
  display: flex;
  gap: var(--space-2);
  align-items: stretch;
}

.page-game .input-row textarea {
  flex: 1;
  min-width: 0;
  min-height: 2.75rem;
  resize: vertical;
  line-height: 1.4;
  padding: 8px 12px;
}

.page-game .input-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  flex-shrink: 0;
}

.page-game .input-actions button {
  white-space: nowrap;
  padding: 10px 16px;
  flex: 1;
}

.page-game .scroll-top-btn {
  padding: 6px 12px !important;
  font-size: 0.85rem;
  background-color: var(--accent);
  color: #000;
  border-color: var(--accent);
}

.page-game .scroll-top-btn:hover {
  background-color: var(--accent);
  border-color: var(--accent);
}

@media (max-width: 960px) {
  .home-hero,
  .auth-stage {
    grid-template-columns: 1fr;
  }

  .home-card-grid,
  .home-flow-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ─── Mobile Overrides ─────────────────────────────── */

@media (max-width: 640px) {
  .home-card-grid,
  .home-flow-grid {
    grid-template-columns: 1fr;
  }

  .auth-screen {
    padding: 14px;
  }

  .auth-panel--hero h1 {
    max-width: 100%;
  }

  .home-hero-actions,
  .auth-note-actions {
    flex-direction: column;
  }

  .home-primary-link,
  .home-secondary-link {
    width: 100%;
  }

  .game-hud {
    flex-wrap: nowrap;
    overflow: hidden;
    gap: 6px 8px;
  }

  .game-hud .hud-divider {
    display: none;
  }

  .game-hud .game-hud-title {
    flex: 1 1 auto;
  }

  .game-hud .subheader-status {
    flex-shrink: 0;
    gap: 4px 8px;
  }

  .game-hud .subheader-status .hud-label {
    display: none;
  }

  .hud-actions-row {
    flex-wrap: wrap;
  }

  .game-subheader {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .subheader-actions {
    width: 100%;
    justify-content: flex-start;
  }

  .options-grid {
    grid-template-columns: 1fr;
  }

  .advanced-actions .action-row {
    flex-direction: column;
  }

  .advanced-actions .action-row select,
  .advanced-actions .action-row button {
    width: 100%;
  }

  .page-worlds .world-card-grid {
    grid-template-columns: 1fr;
  }

  .page-character .character-card-grid {
    grid-template-columns: 1fr;
  }

  .page-worlds .row button {
    width: 100%;
  }

  .skill-grid {
    grid-template-columns: 1fr;
  }

  .derived-bar {
    grid-template-columns: repeat(3, 1fr);
  }

  .attr-row {
    flex-wrap: wrap;
  }

  .attr-info small {
    display: none;
  }
}

@media (min-width: 641px) {
  .skill-grid {
    grid-template-columns: 1fr 1fr;
  }
}

/* ─── Rules Page ───────────────────────────────────── */

.page-rules {
  padding-bottom: var(--space-8);
}

.page-rules-title {
  font-weight: 700;
}

.page-rules-subtitle {
  color: var(--text-muted);
  font-size: var(--font-sm);
  margin: 0 0 var(--space-2);
}

/* ── Collapsible sections ── */

.rules-section {
  background: var(--bg-surface);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-md);
  margin-bottom: 0;
  overflow: hidden;
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.14);
}

.rules-section > summary {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  font-weight: 600;
  font-size: var(--font-base);
  cursor: pointer;
  user-select: none;
  list-style: none;
  transition: background 150ms ease;
}

.rules-section > summary::-webkit-details-marker {
  display: none;
}

.rules-section > summary::before {
  content: '▶';
  font-size: 0.7em;
  transition: transform 200ms ease;
  color: var(--accent);
}

.rules-section[open] > summary::before {
  transform: rotate(90deg);
}

.rules-section > summary:hover {
  background: var(--bg-elevated);
  color: var(--accent);
}

.rules-section[open] > summary {
  border-bottom: 1px solid var(--border-default);
  background: var(--bg-elevated);
}

.rules-section-body {
  padding: var(--space-2) var(--space-4) var(--space-4);
  border-top: 1px solid var(--border-default);
}

/* ── Core rules blocks ── */

.rules-rule-block {
  margin-bottom: var(--space-3);
}

.rules-rule-block:last-child {
  margin-bottom: 0;
}

.rules-rule-block h4 {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--accent);
  margin-bottom: var(--space-1);
}

.rules-rule-block p {
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--text-secondary);
}

/* ── Attribute grid ── */

.rules-attr-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-2);
}

.rules-attr-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-3);
  background: var(--bg-elevated);
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-default);
}

.rules-attr-card strong {
  color: var(--accent);
  font-size: var(--font-sm);
}

.rules-attr-card span {
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: 1.4;
}

/* ── Skills ── */

.rules-skill-group {
  margin-bottom: var(--space-4);
}

.rules-skill-group:last-child {
  margin-bottom: 0;
}

.rules-skill-group-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--accent);
  margin-bottom: var(--space-2);
  padding-bottom: var(--space-1);
  border-bottom: 1px solid var(--border-default);
}

.rules-skill-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.rules-skill-item {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
}

.rules-skill-item:hover {
  background: var(--bg-elevated);
}

.rules-skill-name {
  font-weight: 600;
  font-size: var(--font-sm);
  white-space: nowrap;
  min-width: 140px;
}

.rules-skill-desc {
  font-size: var(--font-xs);
  color: var(--text-muted);
}

/* ── Edges ── */

.rules-edge-group {
  margin-bottom: var(--space-4);
}

.rules-edge-group:last-child {
  margin-bottom: 0;
}

.rules-edge-group-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--accent);
  margin-bottom: var(--space-2);
  padding-bottom: var(--space-1);
  border-bottom: 1px solid var(--border-default);
}

.rules-edge-item {
  padding: var(--space-2) var(--space-2);
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-1);
}

.rules-edge-item:hover {
  background: var(--bg-elevated);
}

.rules-edge-header {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.rules-edge-header strong {
  font-size: var(--font-sm);
}

.rules-edge-req {
  font-size: var(--font-xs);
  color: var(--text-muted);
  background: var(--bg-elevated);
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-default);
}

.rules-edge-desc {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-top: var(--space-1);
  line-height: 1.4;
}

/* ── Hindrances ── */

.rules-hindrance-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.rules-hindrance-item {
  padding: var(--space-2);
  border-radius: var(--radius-sm);
}

.rules-hindrance-item:hover {
  background: var(--bg-elevated);
}

.rules-hindrance-header {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.rules-hindrance-header strong {
  font-size: var(--font-sm);
}

.rules-severity-badge {
  font-size: var(--font-xs);
  font-weight: 600;
  padding: 1px 8px;
  border-radius: var(--radius-sm);
}

.rules-severity--major {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.rules-severity--minor {
  background: rgba(251, 191, 36, 0.15);
  color: #fbbf24;
  border: 1px solid rgba(251, 191, 36, 0.3);
}

.rules-hindrance-desc {
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin-top: var(--space-1);
  line-height: 1.4;
}

/* ── Tables (weapons, armors) ── */

.rules-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.rules-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--font-sm);
}

.rules-table th,
.rules-table td {
  padding: var(--space-2) var(--space-2);
  text-align: left;
  border-bottom: 1px solid var(--border-default);
  white-space: nowrap;
}

.rules-table th {
  font-weight: 600;
  font-size: var(--font-xs);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  background: var(--bg-elevated);
}

.rules-table td {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.rules-table tbody tr:hover {
  background: var(--bg-elevated);
}

/* ── Ranks ── */

.rules-rank-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.rules-rank-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  background: var(--bg-elevated);
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-default);
}

.rules-rank-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-weight: 700;
  font-size: var(--font-xs);
  flex-shrink: 0;
}

.rules-rank-item strong {
  font-size: var(--font-sm);
}

.rules-rank-advances {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
}

/* ── Character creation ── */

.rules-creation-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.rules-creation-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-3);
  background: var(--bg-elevated);
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-default);
  text-align: center;
}

.rules-creation-value {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--accent);
}

.rules-creation-label {
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: 1.3;
}

.rules-creation-note p {
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: var(--space-2);
}

.rules-creation-note p:last-child {
  margin-bottom: 0;
}

.rules-creation-note strong {
  color: var(--accent);
}

/* ── Responsive ── */

@media (max-width: 640px) {
  .rules-attr-grid {
    grid-template-columns: 1fr;
  }

  .rules-creation-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .rules-skill-item {
    flex-direction: column;
    gap: 2px;
  }

  .rules-skill-name {
    min-width: auto;
  }
}

/* ─── Design refresh (2026-06-17): glassmorphism, overlays, mobile touch ─── */

/* World/universe card image with bottom gradient overlay */
.card-image-frame {
  position: relative;
  display: block;
  height: 100%;
  overflow: hidden;
}

.card-image-frame .card-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  filter: brightness(0.8);
  transition: filter 250ms ease, transform 250ms ease;
}

.world-card:hover .card-image-frame .card-image {
  filter: brightness(1);
  transform: scale(1.03);
}

.card-image-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.15) 38%, transparent 60%),
    linear-gradient(to bottom, rgba(0, 0, 0, 0.55) 0%, transparent 30%);
}

/* Glass Pill — input e botão Enviar como dois pills distintos (ref. visual) */
.page-game .form-grid {
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
  border-radius: 0;
}

.page-game .input-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.page-game .input-row textarea {
  flex: 1;
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  min-height: 3rem;
  padding: 12px 22px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.page-game .input-row textarea:focus {
  border-color: rgba(59, 130, 246, 0.5);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(59, 130, 246, 0.3), 0 0 18px rgba(59, 130, 246, 0.2);
  outline: none;
}

.page-game .input-actions {
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.page-game .input-actions button[type="submit"] {
  border-radius: var(--radius-md);
  padding: 12px 26px;
  background: rgba(22, 25, 32, 0.8);
  border: 1px solid rgba(59, 130, 246, 0.4);
  color: #93c5fd;
}

.page-game .input-actions button[type="submit"]:hover:not(:disabled) {
  border-color: #3B82F6;
  color: #bfdbfe;
  box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
}

.page-game .scroll-top-btn {
  border-radius: 50% !important;
  width: 40px;
  height: 40px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Narrativa: mesma família e tamanho do restante da interface (ref. visual) */
.msg.narrator .narrative-text,
.msg.narrator .markdown-view,
.msg.narrator .narrative-text p,
.narrative-segment .markdown-view {
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.65;
  letter-spacing: 0;
}

/* ─── Hierarquia tipográfica unificada do chat (reformulação) ───
   T1 · Corpo (1rem/16px)    — narrativa, fala do jogador, texto da opção
   T2 · Nomes e resultados (0.875rem/14px, 600) — quem fala, valores de teste, status
   T3 · Estrutural/ambiente (0.8125rem/13px)    — separadores, títulos de seção, texto auxiliar
*/

/* T1 — fala do jogador no mesmo corpo da narrativa */
.page-game .msg.player .player-text p,
.page-game .msg.player .player-text .speech-text {
  font-size: 1rem;
  line-height: 1.65;
}

/* T2 — nome de quem fala e resultados de teste, antes minúsculos demais */
.page-game .msg.player .player-text strong,
.page-game .npc-compact-name,
.page-game .dice-result-title,
.page-game .dice-final strong,
.page-game .attack-result-status {
  font-size: 0.875rem;
  font-weight: 600;
}

/* T3 — separadores, títulos de seção e texto auxiliar, antes minúsculos demais */
.page-game .turn-separator-label,
.page-game .action-options-title,
.page-game .summary-header,
.page-game .summary-text,
.page-game .npc-tag,
.page-game .npc-compact-status,
.page-game .item-change,
.page-game .status-change,
.page-game .dice-roll-label,
.page-game .dice-roll-total,
.page-game .dice-result-summary,
.page-game .dice-result-desc,
.page-game .dice-result-badge {
  font-size: 0.8125rem;
}

/* ─── Densidade — menos respiro entre componentes para caber mais itens em tela ─── */
.page-game .chat-log {
  gap: var(--space-1);
}

.page-game .msg {
  padding: var(--space-2) 0;
}

.page-game .msg.player .player-text {
  padding: var(--space-2) var(--space-3);
}

.page-game .narrative-segments {
  gap: var(--space-2);
}

.page-game .npc-dialogue {
  padding: var(--space-1) 0 var(--space-1) var(--space-3);
}

.page-game .action-options {
  margin-top: var(--space-2);
  padding-top: var(--space-2);
}

.page-game .action-options-title {
  margin: 0 0 var(--space-2);
}

.page-game .msg.system-summary {
  padding: 8px 12px;
  margin: 6px 0;
}

/* Resultado de teste/dado: remove o "card" externo redundante (dice-events-block),
   deixando só o card colorido (dice-result-card), igual ao tratamento das msg */
.page-game .dice-events-block {
  margin: var(--space-2) 0;
  padding: 0;
  border-left: none;
  background: none;
  border-radius: 0;
}

.page-game .summary-header {
  margin-bottom: 6px;
}

/* Fade-in + slide-up for new narrative blocks */
@keyframes designRefreshFadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

.msg.narrator,
.narrative-segment,
.npc-dialogue {
  animation: designRefreshFadeIn 320ms ease-out both;
}

/* Touch targets ≥ 44px for dice / action buttons on mobile */
@media (max-width: 640px) {
  .btn-dice-confirm,
  .btn-dice-cancel,
  .dice-confirm-buttons button,
  .page-game .input-actions button,
  .page-character button.die-roll,
  .character-sidebar .skill-roll,
  .character-sidebar .attr-roll,
  .character-sidebar button {
    min-height: 44px;
    padding-block: 10px;
  }

  .page-game .form-grid {
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
}

/* ─── Chat Imersivo Moderno: pills neutras no HUD, só Benny em azul (ref. visual) ─── */

/* Ações / Log / Normal / Ficha: pill neutra (cinza), conforme imagem de referência */
.page-game .pill-ficha,
.page-game .pill-actions,
.page-game .pill-log,
.page-game .pill-speed {
  border-color: var(--border-subtle);
  color: var(--text-secondary);
  background: var(--bg-field);
}

.page-game .pill-ficha:hover,
.page-game .pill-actions:hover,
.page-game .pill-log:hover {
  border-color: var(--border-strong);
  background: var(--bg-surface-hover);
  color: var(--text-primary);
}

/* Benny: único pill com destaque, em azul (acento info da spec) */
.page-game .pill-benny {
  border-color: rgba(59, 130, 246, 0.5);
  color: #93c5fd;
  background: rgba(59, 130, 246, 0.08);
}

.page-game .pill-benny:hover {
  border-color: #3B82F6;
  background: rgba(59, 130, 246, 0.16);
  color: #bfdbfe;
}

/* Bloco de Narração: card completo com borda-gradiente superior + sombra interna (spec) */
.page-game .msg.narrator {
  position: relative;
  overflow: hidden; /* contém o brilho interno na própria caixa, sem vazar e ser cortado de forma desigual pelos vizinhos */
  border-left: none;
  background: rgba(30, 41, 59, 0.4);
  background-image: none;
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  margin-bottom: var(--space-2);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.03),
    inset 0 -24px 32px -24px rgba(0, 0, 0, 0.35),
    0 2px 10px rgba(0, 0, 0, 0.3);
}

.page-game .msg.narrator::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: linear-gradient(90deg, rgba(249, 115, 22, 0.3), transparent);
}

@media (max-width: 640px) {
  .page-game .msg.narrator {
    padding: 1rem;
  }
}

/* Cards de Decisão: estado normal e hover/ativo exatos da spec (azul #3B82F6) */
.page-game .option-btn {
  background: rgba(22, 25, 32, 0.8);
  border-color: rgba(59, 130, 246, 0.2);
  border-radius: 12px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, transform 0.2s ease;
}

.page-game .option-btn:hover:not(:disabled) {
  border-color: #3B82F6;
  background: rgba(59, 130, 246, 0.08);
  box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
  transform: scale(1.02);
}

.page-game .option-btn::before {
  background: #3B82F6;
}

/* Testes de perícia ("Teste: X - TN N"): rótulo neutro, valor em azul suave (spec) */
.page-game .dice-check-info {
  font-size: 0.875rem;
  font-family: var(--font-sans);
  color: var(--text-secondary);
}

.page-game .dice-check-label {
  font-size: 0.875rem;
  font-family: var(--font-sans);
  color: var(--text-secondary);
  font-weight: 500;
}

.page-game .dice-check-value {
  font-size: 0.875rem;
  font-family: var(--font-sans);
  color: #60a5fa;
  font-weight: 500;
}

/* Título da ação e narrativa na mesma escala/família/peso (normalizado, sem negrito) */
.page-game .option-text {
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 400;
  color: var(--text-primary);
  line-height: 1.4;
}

.page-game .option-speech {
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  font-weight: 400;
  color: var(--text-secondary);
}

.page-game .option-reason {
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  font-weight: 400;
}

.page-game .option-btn {
  padding: 0.875rem 1.125rem;
  gap: 4px;
}

.page-game .options-grid {
  gap: var(--space-2);
}

/* Cards com teste de dado: mesma família azul, leve variação para manter a affordance do dado */
.page-game .option-btn.has-dice-check {
  border-color: rgba(59, 130, 246, 0.28);
  background: rgba(22, 25, 32, 0.8);
}

.page-game .option-btn.has-dice-check::before {
  background: #60a5fa;
}

.page-game .option-btn.has-dice-check:hover:not(:disabled) {
  border-color: #3B82F6;
  background: rgba(59, 130, 246, 0.08);
  box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
}

.page-game .input-actions button[type="submit"]:disabled {
  box-shadow: none;
  opacity: 0.5;
}

/* Tipografia de interface: 500 para botões, 600 para títulos (spec) */
.page-game button {
  font-weight: 500;
}

.page-game .game-hud-title {
  font-weight: 600;
}
